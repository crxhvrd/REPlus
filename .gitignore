build.vs/
build/
out/
x64/
*.asi
*.zip
*.lib
*.exp
*.pdb
*.ilk
*.map
*.obj

# ---------------------------------------------------------------------------
# Runtime artefacts - written next to the game, but easy to drag in by mistake
#
# The .ini files are GENERATED: their text lives in CMakeLists.txt and the build
# writes them next to the .asi. None of them belongs in the repo, wherever a
# copy turns up - a tracked one would drift from the generator and collect
# whatever settings were last tested in-game.
# ---------------------------------------------------------------------------
*.log
Captures/
markers/
ffmpeg.exe
RockstarEditorPlus.ini
Render.ini

# presets\ is a runtime folder next to the game, EXCEPT the shipped set under
# dist\ - the README names those five by name, so a clone needs them.
presets/
!dist/RockstarEditorPlus/presets/
!dist/RockstarEditorPlus/presets/*.ini

# ---------------------------------------------------------------------------
# Editor / OS
# ---------------------------------------------------------------------------
.vs/
.vscode/
CMakeSettings.json
*.user
Thumbs.db
desktop.ini
